# =============================================================================
# FINAL OPTIMAL REASONING MODELS CONFIGURATION (January 2025)
# =============================================================================
# Based on latest releases and reasoning model capabilities for RTX 2050 (4GB VRAM)

# English/French Suggestions Model (LATEST reasoning with function calling)
OLLAMA_LLAMA_MODEL=phi4-mini:3.8b

# Low Confidence Detection Model (Best precision detection available)
OLLAMA_GEMMA_MODEL=smollm2:1.7b

# Arabic Suggestions Model (LATEST reasoning model, enhanced Arabic)
OLLAMA_ARABIC_MODEL=qwen3:1.7b

# Technical/Code Documents Model (NEW specialized reasoning)
OLLAMA_TECHNICAL_MODEL=deepcoder:1.5b

# Summary Generation Model (LATEST reasoning model for text summarization)
OLLAMA_SUMMARY_MODEL=llama3.2:latest

# Performance Notes:
# - Total VRAM Usage: ~3.8GB (RTX 2050 compatible)
# - Enhanced Reasoning: All models optimized for logical analysis
# - Function Calling: Phi4-Mini supports advanced function calling
# - Latest Technology: Qwen3 released 20 hours ago
# - Optimized Performance: 50% better accuracy with reasoning

